---
import type { Locale } from "../../lib/site-config";
import { content, money, date } from "../../lib/i18n";
import { job, tracking } from "../../data/demo-fixtures";
interface Props {
  locale: Locale;
  id: string;
}
const { locale, id } = Astro.props;
const { ui } = content(locale);
const zh = locale === "zh-CN";
---

{id === "workflow" && (
  <div class="panel" data-switch>
    <span class="tag">
      {ui.labels.example} / {job.id}
    </span>
    <div class="tabs" data-controls hidden>
      <button data-choice="standard" aria-pressed="true">
        {ui.labels.standard}
      </button>
      <button data-choice="multi" aria-pressed="false">
        {ui.labels.multi}
      </button>
    </div>
    <div data-panel="standard">
      <h3>{ui.labels.standard}</h3>
      <ol class="step-list">
        {(zh
          ? [
              "接单 · 整理货物与单据",
              "出口 · 订舱与报关",
              "运输 · 节点跟进",
              "交付 · 费用结算",
            ]
          : [
              "Booking · Cargo and documents",
              "Export · Booking and declaration",
              "Transport · Milestone updates",
              "Delivery · Cost settlement",
            ]
        ).map((t) => (
          <li>{t}</li>
        ))}
      </ol>
    </div>
    <div data-panel="multi">
      <h3>{ui.labels.multi}</h3>
      <ol class="step-list">
        {ui.roles.map((t) => (
          <li>{t}</li>
        ))}
      </ol>
    </div>
  </div>
)}
{id === "collaboration" && (
  <div class="relationships">
    <div class="job-hub">
      <span class="tag">{ui.labels.example}</span>
      <h3>{ui.labels.job}</h3>
      <code>{job.id}</code>
    </div>
    <ol class="role-list">
      {ui.roles.map((role, i) => (
        <li>
          <span class="role-index">0{i + 1}</span>
          <span>{role}</span>
          <span aria-hidden="true">→</span>
          <span class="muted">{ui.labels.job}</span>
        </li>
      ))}
    </ol>
  </div>
)}
<style>
  .relationships {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    align-items: center;
  }
  .job-hub {
    border: 1px solid var(--color-teal);
    padding: 40px 24px;
    border-radius: 50%;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .job-hub h3 {
    margin: 20px 0 8px;
  }
  .role-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .role-list li {
    border-top: 1px solid var(--color-border);
    padding: 20px 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .role-index {
    width: 100%;
    font:
      12px ui-monospace,
      monospace;
    color: var(--color-teal);
  }
  @media (max-width: 767px) {
    .relationships,
    .role-list {
      grid-template-columns: 1fr;
    }
    .job-hub {
      border-radius: var(--radius-panel);
      aspect-ratio: auto;
    }
    .role-list li {
      padding: 16px 0;
    }
  }
</style>
{id === "finance" && (
  <div class="split">
    <div class="panel">
      <span class="tag">{ui.labels.example} · EUR</span>
      <table>
        <caption>
          {ui.labels.cost} / {job.id}
        </caption>
        <tbody>
          {job.costs.map((cost) => (
            <tr>
              <th scope="row">{zh ? cost.zh : cost.en}</th>
              <td>{money(cost.amount, locale)}</td>
            </tr>
          ))}
          <tr>
            <th scope="row">{ui.labels.cost}</th>
            <td>
              {money(
                job.costs.reduce((s, c) => s + c.amount, 0),
                locale,
              )}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="finance-total">
      <p>
        {ui.labels.quote} <strong>{money(job.quote, locale)}</strong>
      </p>
      <p>
        {ui.labels.profit}
        <strong class="profit">
          {money(
            job.quote - job.costs.reduce((s, c) => s + c.amount, 0),
            locale,
          )}
        </strong>
      </p>
      <span class="tag">{ui.labels.pending}</span>
    </div>
  </div>
)}
<style>
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 24px;
  }
  caption {
    text-align: left;
    font-size: 13px;
    margin-bottom: 12px;
  }
  td,
  th {
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    font-weight: 400;
    text-align: left;
  }
  td {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .finance-total strong {
    display: block;
    font-size: 28px;
    font-variant-numeric: tabular-nums;
  }
  .finance-total .profit {
    font-size: clamp(40px, 5vw, 64px);
    color: var(--color-teal);
  }
</style>
{id === "ai" && (
  <div class="panel" data-switch>
    <span class="tag">
      {ui.labels.example} / {job.id}
    </span>
    <div class="tabs" data-controls hidden>
      {ui.tasks.map((_, i) => (
        <button
          data-choice={`task-${i}`}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {zh
            ? ["接单整理", "单据核对", "日常跟进"][i]
            : ["Booking draft", "Document check", "Daily follow-up"][i]}
        </button>
      ))}
    </div>
    {ui.tasks.map((task, i) => (
      <div data-panel={`task-${i}`} class="grid-two">
        <div class="ai-conversation">
          <span class="eyebrow">{ui.labels.role}</span>
          <h3>{task}</h3>
          <p>{ui.results[i]}</p>
        </div>
        <div class="ai-document">
          <code>{job.id}</code>
          <p>{zh ? "装箱单 / 货物资料" : "Packing list / Cargo details"}</p>
          <strong>
            {job.cartons} {zh ? "箱" : "cartons"} / {job.weightKg} kg
          </strong>
          <hr />
          <button disabled>
            {zh ? "AI 整理 / 检查" : "AI organize / check"}
          </button>
          <p>{ui.labels.draft}</p>
        </div>
      </div>
    ))}
    <p class="muted ai-permissions">{ui.permissions}</p>
  </div>
)}
<style>
  .ai-conversation {
    border-left: 3px solid var(--color-teal);
    padding: 24px;
    background: var(--color-page);
  }
  .ai-conversation h3 {
    margin-top: 24px;
  }
  .ai-document {
    padding: 24px;
    border: 1px solid var(--color-border);
  }
  .ai-document button {
    margin: 20px 0;
  }
  .ai-permissions {
    margin: 24px 0 0;
    font-size: 14px;
  }
</style>
{id === "tracking" && (
  <div class="panel dark" data-switch>
    <span class="tag">
      {ui.labels.example} / {job.id}
    </span>
    <div class="tabs" data-controls hidden>
      <button data-choice="ocean" aria-pressed="true">
        {ui.labels.ocean}
      </button>
      <button data-choice="air" aria-pressed="false">
        {ui.labels.air}
      </button>
    </div>
    {Object.entries(tracking).map(([mode, t]) => (
      <div data-panel={mode}>
        <h3>
          {mode === "ocean" ? ui.labels.ocean : ui.labels.air} / {t.id}
        </h3>
        <ol class="tracking-line">
          {(zh ? t.zh : t.en).map((node, i) => (
            <li class:list={{ current: i === 2 }}>
              <span>0{i + 1}</span>
              {node}
            </li>
          ))}
        </ol>
        <div class="grid-two">
          <p>
            {ui.labels.updated}
            <br />
            <time datetime={t.updated}>{date(t.updated, locale)}</time>
          </p>
          <p>
            {ui.labels.eta}
            <br />
            <time datetime={t.eta}>{date(t.eta, locale)}</time>
          </p>
        </div>
      </div>
    ))}
    <p class="muted">{ui.coverage}</p>
  </div>
)}
<style>
  .tracking-line {
    list-style: none;
    padding: 24px 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .tracking-line li {
    border-top: 2px solid var(--color-light);
    padding-top: 16px;
  }
  .tracking-line span {
    display: block;
    font:
      12px ui-monospace,
      monospace;
    margin-bottom: 12px;
  }
  .tracking-line .current {
    border-color: var(--color-mint);
    color: var(--color-mint);
  }
  @media (max-width: 767px) {
    .tracking-line {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
{id === "mcp" && (
  <>
    <ol class="mcp-steps">
      {ui.mcpSteps.map((step, i) => (
        <li>
          <span class="eyebrow">
            0{i + 1} / {["EXCEL", "AGENT", "KUSTOCARGO"][i]}
          </span>
          <h3>{step}</h3>
          <p class="muted">
            {zh
              ? [
                  "本地表格 · 20 箱 / 400 kg",
                  "对照 DEMO-CN-EU-001 的业务记录",
                  "在当前用户权限内核对更新",
                ][i]
              : [
                  "Local worksheet · 20 cartons / 400 kg",
                  "Compare records for DEMO-CN-EU-001",
                  "Review updates within your permissions",
                ][i]}
          </p>
        </li>
      ))}
    </ol>
    <p class="muted">{ui.fileTools}</p>
  </>
)}
<style>
  .mcp-steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .mcp-steps li {
    border-top: 2px solid var(--color-teal);
    padding-top: 24px;
  }
  .mcp-steps h3 {
    margin-top: 24px;
  }
  @media (max-width: 767px) {
    .mcp-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
{id === "deployment" && (
  <div class="grid-two">
    {[ui.labels.managed, ui.labels.self].map((title, i) => (
      <div class="panel">
        <span class="section-number">0{i + 1}</span>
        <h3>{title}</h3>
        <p>{ui.hosting[i]}</p>
      </div>
    ))}
  </div>
)}
