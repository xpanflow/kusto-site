---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import type { Locale } from "../lib/site-config";

interface Props {
  locale: Locale;
  screen: "bookings" | "import-job";
}
const { locale, screen } = Astro.props;
const examples = {
  bookings: {
    title: {
      "zh-CN": "从委托单安排运输",
      en: "Plan a shipment from a booking",
    },
    caption: {
      "zh-CN":
        "以 B26-0033 为例，销售可以在委托单列表中核对法兰克福至上海的航线，以及预计出发和到达日期。",
      en: "In this Chinese demo, sales can check booking B26-0033 from Frankfurt to Shanghai, including its expected departure and arrival dates.",
    },
  },
  "import-job": {
    title: {
      "zh-CN": "在工作单里交接资料",
      en: "Hand over documents in the job record",
    },
    caption: {
      "zh-CN":
        "工作单 J26-0033 显示了各部门的进度。进口部接手时，就能看到还需补齐商业发票和装箱单。",
      en: "Demo job J26-0033 shows each department’s progress in the Chinese interface. The import team can see that the commercial invoice and packing list are still missing.",
    },
  },
};
const example = examples[screen];
const openLabel = locale === "en" ? "View full-size screenshot" : "查看原图";
function screenshotUrl(device: "desktop" | "mobile") {
  const base = `assets/product/${screen}-${device}`;
  const extension = ["png", "webp", "jpg", "jpeg"].find((ext) =>
    existsSync(resolve("public", `${base}.${ext}`)),
  );
  return extension ? `/${base}.${extension}` : undefined;
}
const desktopUrl = screenshotUrl("desktop");
const mobileUrl = screenshotUrl("mobile");
const desktop =
  screen === "bookings"
    ? { width: 1585, height: 992 }
    : { width: 1487, height: 1058 };
---

{desktopUrl && mobileUrl && (
  <figure class="container product-screen">
    <figcaption>
      <strong>{example.title[locale]}</strong>
      <p>{example.caption[locale]}</p>
    </figcaption>
    <div class="stage">
      {[
        {
          url: desktopUrl,
          label: locale === "en" ? "Web" : "网页版",
          size: desktop,
          phone: false,
        },
        {
          url: mobileUrl,
          label: locale === "en" ? "Mobile" : "移动端",
          size: { width: 390, height: 844 },
          phone: true,
        },
      ].map(({ url, label, size, phone }) => (
        <a
          class:list={["preview", { phone }]}
          href={url}
          aria-label={`${label} · ${example.title[locale]} · ${openLabel}`}
        >
          <span class="device">
            <span class="chrome" aria-hidden="true"></span>
            <img
              src={url}
              {...size}
              loading="lazy"
              decoding="async"
              alt={`${example.title[locale]} · ${label}`}
            />
          </span>
          <span class="device-label">
            {label}
            <svg
              aria-hidden="true"
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M3 13 13 3M4 3h9v9" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </figure>
)}
<style>
  .product-screen {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    border-top: 1px solid var(--color-border);
    margin-block: clamp(2rem, 4vw, 3.5rem) 0;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  figcaption strong {
    display: block;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.35;
    text-wrap: balance;
  }
  figcaption p {
    margin: 0.75rem 0 0.5rem;
    color: var(--color-muted);
    max-width: 36ch;
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: clamp(10px, 2vw, 24px);
    align-items: end;
    padding: clamp(14px, 2.5vw, 32px);
    border-radius: var(--radius-panel);
    background: color-mix(in srgb, var(--color-border) 40%, var(--color-page));
  }
  .preview {
    display: block;
    min-width: 0;
    text-decoration: none;
    border-radius: 8px;
  }
  .device {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    box-shadow: 0 6px 18px
      color-mix(in srgb, var(--color-ocean) 9%, transparent);
  }
  .chrome {
    display: flex;
    align-items: center;
    height: clamp(12px, 1.8vw, 24px);
    padding-inline: 8px;
    background: var(--color-page);
    border-bottom: 1px solid var(--color-border);
  }
  .chrome::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-light);
    box-shadow:
      7px 0 var(--color-light),
      14px 0 var(--color-light);
  }
  .phone .device {
    padding: 0 3px 6px;
    border-color: var(--color-muted);
    border-radius: clamp(8px, 1.4vw, 18px);
    background: var(--color-ocean);
  }
  .phone .chrome {
    height: clamp(6px, 1vw, 12px);
    justify-content: center;
    border: 0;
    background: transparent;
  }
  .phone .chrome::before {
    width: 24%;
    height: 2px;
    border-radius: 4px;
    background: var(--color-muted);
    box-shadow: none;
  }
  .phone img {
    border-radius: 3px 3px 7px 7px;
  }
  .product-screen img {
    display: block;
    width: 100%;
    height: auto;
  }
  .device-label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    color: var(--color-teal);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .preview:hover .device-label,
  .preview:focus-visible .device-label {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  @media (max-width: 900px) {
    .product-screen {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    figcaption p {
      max-width: 60ch;
    }
  }
  @media (max-width: 480px) {
    .stage {
      grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
      padding: 12px;
      gap: 10px;
    }
    .phone .device {
      padding: 0 2px 3px;
    }
  }
</style>
