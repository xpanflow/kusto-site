---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import type { Locale } from "../lib/site-config";

interface Props {
  locale: Locale;
  screen: "bookings" | "import-job";
}
const { locale, screen } = Astro.props;
const descriptions = {
  bookings: {
    "zh-CN":
      "委托单示例：销售按客户和状态筛选委托，核对航线、预计出发和到达日期。",
    en: "Demo bookings in the Chinese interface. Sales can filter by customer and status, then check the route and expected departure and arrival dates.",
  },
  "import-job": {
    "zh-CN":
      "进口工作单 J26-0033：进口部接手法兰克福至上海的空运业务，可查看各部门进度，以及待补的商业发票和装箱单。",
    en: "Demo import job J26-0033 in the Chinese interface. The import team can see each department’s progress and the missing commercial invoice and packing list for the Frankfurt–Shanghai air shipment.",
  },
};
function screenshotUrl(device: "desktop" | "mobile") {
  const base = `assets/product/${screen}-${device}`;
  const extension = ["png", "webp", "jpg", "jpeg"].find((ext) =>
    existsSync(resolve("public", `${base}.${ext}`)),
  );
  return extension ? `/${base}.${extension}` : undefined;
}
const desktopUrl = screenshotUrl("desktop");
const mobileUrl = screenshotUrl("mobile");
const desktop =
  screen === "bookings"
    ? { width: 1585, height: 992 }
    : { width: 1487, height: 1058 };
---

{desktopUrl && mobileUrl && (
  <figure class="container product-screen">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset={mobileUrl}
        width="390"
        height="844"
      />
      <img
        src={desktopUrl}
        {...desktop}
        loading="lazy"
        decoding="async"
        alt={
          screen === "bookings"
            ? locale === "en"
              ? "Booking list with B26-0033 confirmed"
              : "委托单列表，B26-0033 已确认"
            : locale === "en"
              ? "Import job showing outstanding documents and pickup fields"
              : "进口工作单的待补资料提示与提货字段"
        }
      />
    </picture>
    <figcaption>{descriptions[screen][locale]}</figcaption>
  </figure>
)}
<style>
  .product-screen {
    margin-block: clamp(2rem, 5vw, 4rem) 0;
  }
  .product-screen img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
  }
  figcaption {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }
  @media (max-width: 767px) {
    .product-screen {
      max-width: 390px;
    }
  }
</style>
