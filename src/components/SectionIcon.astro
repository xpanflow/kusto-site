<span class="section-icon" aria-hidden="true">
  <svg
    width="28"
    height="28"
    viewBox="-2 -2 28 28"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
