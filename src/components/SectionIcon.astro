</span>
<style>
  .section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border: 1px solid #08758230;
    border-radius: 14px;
    background: #0875820a;
    color: var(--color-teal);
  }
  :global(.dark) .section-icon {
    color: var(--color-mint);
    border-color: #55d6c240;
    background: #55d6c20a;
