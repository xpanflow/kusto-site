---
import type { Locale } from "../lib/site-config";
import { content, languagePath } from "../lib/i18n";
import Contact from "./sections/Contact.astro";
import Features from "./sections/Features.astro";
import Journey from "./sections/Journey.astro";
import "../styles/journey.css";
import Logo from "./layout/Logo.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { copy, ui } = content(locale);
const copyrightYear = new Date().getUTCFullYear();
---

<a class="skip" href="#main">
  {ui.labels.skip}
</a>
<header class="site-header">
  <div class="container header-inner">
    <Logo light />
    <details class="site-menu">
      <summary
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        {ui.labels.menu}
      </summary>
      <nav class="site-nav" id="site-nav" aria-label={ui.labels.menu}>
        {["workflow", "ai", "tracking", "contact"].map((id, i) => (
          <a href={`#${id}`}>{ui.nav[i]}</a>
        ))}
        <a
          data-language
          href={languagePath(locale)}
          lang={locale === "en" ? "zh-CN" : "en"}
        >
          {locale === "en" ? "中文" : "English"} →
        </a>
      </nav>
    </details>
  </div>
</header>
<main id="main">
  <Journey ui={ui} />
  {Object.entries(copy)
    .filter(([id]) => id !== "contact")
    .map(([id, section], i) => (
      <section id={id} class="section">
        <div class:list={["container", { split: id === "workflow" }]}>
          <div class="section-heading">
            <span class="section-number">0{i + 2} / KUSTOCARGO</span>
            <h2>{section.title}</h2>
            <p class="muted">{section.body}</p>
          </div>
          <Features id={id} locale={locale} />
        </div>
      </section>
    ))}
  <section id="faq" class="section">
    <div class="container split">
      <h2>{locale === "en" ? "A few things to know." : "你可能想了解。"}</h2>
      <div>
        {ui.faq.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <Contact locale={locale} />
</main>
<footer class="footer dark">
  <div class="container footer-inner">
    <Logo light />
    <p>{ui.footer}</p>
    <span class="eyebrow">CHINA ↔ EUROPE</span>
  </div>
  <div class="container footer-bottom">
    <small>© {copyrightYear} KustoCargo · 途序</small>
    <nav aria-label={locale === "en" ? "Footer" : "页脚导航"}>
      <a href="#contact">{ui.nav[3]}</a>
      <a href="#journey">{ui.backToTop} ↑</a>
    </nav>
  </div>
</footer>
<script>
  import "../scripts/navigation";
</script>
<script>
  import "../scripts/feature-demos";
</script>
