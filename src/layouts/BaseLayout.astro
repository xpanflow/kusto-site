---
import type { Locale } from "../lib/site-config";

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: #10283f;
    background: #f5f7f8;
  }

  body {
    margin: 0;
  }

  a {
    color: #087f8c;
  }
</style>
