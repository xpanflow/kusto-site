---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout locale="zh-CN" title="404 · KustoCargo" indexable={false}>
  <main class="container section">
    <p class="eyebrow">404 / KUSTOCARGO</p>
    <h1>
      页面未找到。
      <br />
      Page not found.
    </h1>
    <p>这个地址没有对应页面。 / This address does not have a page.</p>
    <div class="actions">
      <a class="button primary" href="/">
        返回中文首页
      </a>
      <a class="button" href="/en/">
        English home
      </a>
    </div>
  </main>
</BaseLayout>
